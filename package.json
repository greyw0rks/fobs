{
  "name": "fobs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "db:generate": "pnpm --dir apps/web prisma generate",
    "db:push": "pnpm --dir apps/web prisma db push",
    "db:dev": "node scripts/dev-schema.mjs && DATABASE_URL=file:./dev.db pnpm --dir apps/web exec prisma db push --schema=prisma/schema.dev.prisma",
    "db:dev:reset": "node scripts/dev-schema.mjs && DATABASE_URL=file:./dev.db pnpm --dir apps/web exec prisma db push --schema=prisma/schema.dev.prisma --force-reset",
    "seed:db": "DATABASE_URL=file:./dev.db tsx scripts/seed-db.ts",
    "db:verify": "pnpm --dir apps/web verify:db",
    "db:verify:dev": "DATABASE_URL=file:./dev.db pnpm --dir apps/web verify:db",
    "build:program": "bash scripts/build-program.sh",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test --skip-build",
    "test:onchain": "bash scripts/test-onchain.sh",
    "anchor:deploy": "anchor deploy --provider.cluster devnet",
    "devnet:bootstrap": "tsx scripts/devnet-bootstrap.ts",
    "devnet:users": "tsx scripts/devnet-users.ts",
    "devnet:verify": "tsx scripts/verify-devnet.ts",
    "anchor:sync-keys": "anchor keys sync",
    "idl": "node scripts/build-idl.mjs",
    "idl:types": "anchor idl type target/idl/fomo.json -o target/types/fomo.ts",
    "verify:pyth": "tsx scripts/verify-pyth-feeds.ts",
    "smoke:loop": "pnpm --dir apps/web smoke:loop",
    "smoke:onboard": "pnpm --dir apps/web smoke:onboard",
    "rehearse": "pnpm --dir apps/web rehearse"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@prisma/client": "^6.15.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "bs58": "^6.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@11.19.0"
}
