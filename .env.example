# --- The app ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Printed by `pnpm devnet:bootstrap`. The default below is the placeholder from
# the repo; a real deployment has its own.
NEXT_PUBLIC_FOMO_PROGRAM_ID=Fomo9DbW4wbTRSz9eU82Tp1HH27LQJPUYZzcZoSKonxL

# Postgres is the canonical schema. The dev workflow does not use it: `pnpm db:dev`
# mechanically rewrites this schema into a SQLite one at prisma/schema.dev.prisma
# and runs against `file:./dev.db`. Set this only for a real Postgres deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fobs

# --- Chain --------------------------------------------------------------------
# Server-side RPC. Used to sign, send and index.
SOLANA_RPC_URL=https://api.devnet.solana.com

# What the *browser's* wallet adapter points at. Has to be a NEXT_PUBLIC_*
# variable: Next only inlines those into the client bundle, and reaching for a
# server-only name in a client component yields `undefined` rather than an error.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Printed by `pnpm devnet:bootstrap`. The test USDC the program mints.
NEXT_PUBLIC_USDC_MINT=

# The key that ran `pnpm devnet:bootstrap`. This is the protocol's admin: it
# writes the oracle and funds new accounts. Signing and price-pushing are both
# operator powers and neither works without it.
ANCHOR_WALLET=~/.config/solana/id.json

# How much devnet SOL each seeded/onboarding wallet is funded with. The default
# (0.35) is sized to the faucet's per-IP daily cap so that all ten trading
# accounts can be funded from one admin. Each trade permanently costs its trader
# ~1.86M lamports of receipt rent, so 0.35 is roughly a day of activity per
# trader at the default loop interval.
FOBS_SOL_PER_USER=

# Seals each user's devnet keypair at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Without it, custody onboarding is unavailable and only external wallets work.
FOBS_CUSTODY_KEY=

# --- Sign-in ------------------------------------------------------------------
# All three providers are optional, and each activates only when its variables
# are present. The sign-in page states plainly which are configured, rather than
# hiding the ones that are not.
#
# Wallet sign-in needs nothing here: it is a signature check against a public
# key, so it works as soon as the visitor has a wallet.

# X. X_CALLBACK_URL must be a *publicly reachable* HTTPS URL — X's servers make
# that redirect, not the browser, so localhost cannot work.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# Google. Create an OAuth 2.0 client in Google Cloud Console and register
# {GOOGLE_CALLBACK_URL} as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Escape hatch for demoing a production build locally. Allows the seeded test
# accounts to be signed in as, which is otherwise impossible outside dev.
FOBS_ALLOW_TEST_SIGNING=

# --- Background loops ---------------------------------------------------------
# Nothing to configure here. The price push and the trader activity loop are not
# part of the web server: they sign devnet transactions with keys this operator
# holds, so they run as their own processes, started with `pnpm loops` beside
# `pnpm dev`. Cadence is a CLI argument, not an environment variable:
#
#   pnpm loops                 # both, 30s prices and 45s activity
#   pnpm loops -- --every 90   # slower, forwarded to both
#
# They are also each runnable alone (`pnpm prices -- --loop`, `pnpm traders --
# --loop`), which is how you should watch them the first time — every round is a
# real transaction and the point of a loop like that is seeing what it costs
# before you leave it running.
