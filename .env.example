# --- App ---
# Public origin of the deployment (used to build OAuth callback URLs, share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Postgres in production (Neon), or a local Postgres/SQLite URL for development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fobs

# --- Solana RPC (mainnet) ---
# Everything fobs reads and every swap it builds is mainnet. These default to the
# public mainnet-beta endpoint if unset; use your own RPC in production.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PYTH_RPC_URL=https://api.mainnet-beta.solana.com
PRESTOCKS_RPC_URL=https://api.mainnet-beta.solana.com

# --- Jupiter (routing / quotes / swaps) ---
# Optional overrides; the app falls back to Jupiter's public endpoints.
JUPITER_QUOTE_URL=
JUPITER_SWAP_URL=

# --- Market data ---
# Twelve Data API key, used for close-to-close 1D reference changes.
TWELVEDATA_API_KEY=

# --- Sign in with X (OAuth2 + PKCE) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback

# --- Sign in with Google (OIDC + PKCE) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
